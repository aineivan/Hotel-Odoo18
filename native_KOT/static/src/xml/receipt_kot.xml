<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="native_KOT.OrderSummary" t-inherit="point_of_sale.OrderSummary" t-inherit-mode="extension">
        <xpath expr="//OrderWidget" position="before">
            <t t-if="currentOrder and currentOrder.waiter_name">
                <div class="waiter-cart-badge p-2 text-center fw-bold"
                     style="background-color: #e2e8f0; color: #334155; border-bottom: 2px solid #cbd5e1; font-size: 15px;">
                    <i class="fa fa-user-circle me-2" /> Waiter: <t t-esc="currentOrder.waiter_name" />
                </div>
            </t>
            <div class="d-flex flex-row gap-2 flex-fill mb-2 px-2">
                <button class="button btn btn-secondary btn-lg flex-fill" t-on-click="onSelectWaiter">
                    <i class="fa fa-user me-1" />
                    <t t-if="currentWaiter">
                        <t t-esc="currentWaiter.name" />
                    </t>
                    <t t-else="">
                        Select Waiter
                    </t>
                </button>
                <button class="button btn btn-secondary btn-lg flex-fill" t-on-click="onPrintKOT">
                    <i class="fa fa-print me-1" /> Print KOT
                </button>
            </div>
        </xpath>
    </t>

</templates>
